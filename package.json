{
  "name": "arena-saas-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm run dev --prefix server",
    "dev:full": "concurrently -n api,web -c green,blue \"npm run dev:api\" \"wait-on tcp:127.0.0.1:3001 && npm run dev\"",
    "build": "vite build",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json",
    "preview": "vite preview",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f",
    "db:seed": "npm run seed --prefix server",
    "migrate": "npm run migrate --prefix server",
    "test:g1": "node scripts/g1-cross-tenant.mjs",
    "test:match-lock": "node scripts/match-optimistic-lock.mjs",
    "test:paid-join": "node scripts/paid-join-e2e.mjs",
    "test:integration": "npm run test:g1 && npm run test:match-lock && npm run test:paid-join",
    "test:media-url": "node --test src/lib/matchResultsMediaUrl.test.js",
    "playwright:install": "playwright install chromium",
    "test:e2e": "playwright test"
  },
  "dependencies": {
