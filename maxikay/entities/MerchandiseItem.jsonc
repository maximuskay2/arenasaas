{
  "name": "MerchandiseItem",
  "type": "object",
  "properties": {
    "tournament_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "jersey",
        "hat",
        "hoodie",
        "other"
      ]
    },
    "image_url": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "stock": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "tournament_id",
    "name",
    "category",
    "price"
  ]
}