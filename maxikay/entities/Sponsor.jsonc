{
  "name": "Sponsor",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "tournament_id": {
      "type": "string",
      "description": "Optional: link to specific tournament, blank = global"
    },
    "name": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "website_url": {
      "type": "string"
    },
    "tier": {
      "type": "string",
      "enum": [
        "title",
        "gold",
        "silver",
        "bronze"
      ],
      "default": "silver"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "tier"
  ]
}