{
  "name": "PaymentLedger",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "credit",
        "debit"
      ],
      "description": "Direction of funds"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "source": {
      "type": "string",
      "enum": [
        "registration",
        "withdrawal",
        "refund",
        "platform_fee"
      ],
      "description": "Origin of the transaction"
    },
    "tournament_id": {
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed",
        "reversed"
      ],
      "default": "completed"
    },
    "reference": {
      "type": "string",
      "description": "External payment reference"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "type",
    "amount",
    "source"
  ]
}