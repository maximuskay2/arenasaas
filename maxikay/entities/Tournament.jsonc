{
  "name": "Tournament",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant this tournament belongs to"
    },
    "name": {
      "type": "string",
      "description": "Tournament name"
    },
    "game_template_id": {
      "type": "string",
      "description": "Reference to GameTemplate"
    },
    "game_title": {
      "type": "string",
      "description": "Game name for display"
    },
    "format": {
      "type": "string",
      "enum": [
        "single_elimination",
        "double_elimination",
        "round_robin",
        "swiss"
      ],
      "description": "Tournament bracket format"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "registration_open",
        "registration_closed",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "draft"
    },
    "description": {
      "type": "string"
    },
    "banner_url": {
      "type": "string"
    },
    "max_teams": {
      "type": "number"
    },
    "registered_teams": {
      "type": "number",
      "default": 0
    },
    "prize_pool": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "entry_type": {
      "type": "string",
      "enum": ["FREE", "PAID"],
      "default": "FREE",
      "description": "FREE = no entry payment; PAID = entry_fee required via wallet or checkout"
    },
    "entry_fee": {
      "type": "number",
      "default": 0
    },
    "payout_config": {
      "type": "object",
      "description": "Intent: % or notes for prize pool vs tenant share (server-side)"
    },
    "start_date": {
      "type": "string",
      "format": "date-time"
    },
    "end_date": {
      "type": "string",
      "format": "date-time"
    },
    "registration_deadline": {
      "type": "string",
      "format": "date-time"
    },
    "check_in_duration_minutes": {
      "type": "number",
      "default": 15
    },
    "seeding_method": {
      "type": "string",
      "enum": [
        "manual",
        "by_rank",
        "random"
      ],
      "default": "random"
    },
    "rules": {
      "type": "string"
    },
    "stream_url": {
      "type": "string",
      "description": "Twitch channel URL or YouTube stream URL for live broadcast"
    }
  },
  "required": [
    "name",
    "format",
    "max_teams",
    "start_date"
  ]
}