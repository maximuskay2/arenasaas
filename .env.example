# Copy to `.env.local` for Vite (local overrides).
# Vite only exposes variables prefixed with VITE_.

# --- Local API ---
# Leave empty to use Vite proxy (/api → localhost:3001). Set full URL for production build testing.
# VITE_API_URL=http://localhost:3001

# false = marketing landing at localhost; true = organizer portal (app.* behavior)
VITE_DEV_PORTAL=true

# Optional: fix cross-origin redirects when marketing and app use different origins
# VITE_APP_PORTAL_ORIGIN=https://app.yourdomain.com
# VITE_MARKETING_SITE_ORIGIN=https://www.yourdomain.com

# Local only: simulate admin.yourdomain.com (platform super-admin shell). Do not set in public builds.
# VITE_SIMULATE_ENTRY=admin

# --- Local Postgres (optional; docker-compose defaults match these) ---
# Apply schema: psql "$DATABASE_URL" -f src/db/schema.sql
DATABASE_URL=postgresql://arena:arena_dev@localhost:5433/arena_dev

# --- Local Redis (optional; Socket.io adapter / BullMQ later) ---
REDIS_URL=redis://localhost:6379

# --- Future NestJS / server (.env for API repo, not Vite) ---
# STRIPE_SECRET_KEY=
# PAYSTACK_SECRET_KEY=
# FLUTTERWAVE_SECRET_KEY=
