PORT=3001
# Owner/superuser for migrate.js (creates RLS, arena_app role). Same as docker-compose user.
DATABASE_URL=postgresql://arena:arena_dev@localhost:5433/arena_dev
# API runtime: use arena_app so RLS is enforced (NOBYPASSRLS). Password set by migrate (ARENA_APP_PASSWORD).
DATABASE_RUNTIME_URL=postgresql://arena_app:arena_app_dev@localhost:5433/arena_dev
# Optional: separate admin pool for seed/migrations when runtime is arena_app only (omit if migrate runs out-of-band).
# DATABASE_ADMIN_URL=postgresql://arena:arena_dev@localhost:5433/arena_dev
# Password applied to role arena_app on each migrate (default arena_app_dev)
ARENA_APP_PASSWORD=arena_app_dev

JWT_SECRET=change-me-in-production-min-32-chars
FRONTEND_URL=http://localhost:5173

# New organizer signups: tenant row starts as `pending` until platform admin approves (Central Station → Tenants → Approve org).
# Set to false for local dev if you want instant-active tenants without approval.
# TENANT_REGISTRATION_REQUIRES_APPROVAL=true

# Optional: seed three demo tenants + tournaments + demo players (`npm run seed` also enables this via force).
# SEED_DEMO_SCENARIO=true
# DEMO_SEED_PASSWORD=demo123

# Comma/newline-separated IPs allowed to call APIs as platform admin (role admin). Empty = no restriction.
# ADMIN_IP_ALLOWLIST=203.0.113.10,198.51.100.0

# When true, platform admins cannot log in until TOTP MFA is enabled (Central Station → Security).
# MFA_REQUIRED_FOR_ADMIN=false

# When true, tenant super_admin users cannot log in until TOTP MFA is enabled (League command post → Security).
# MFA_REQUIRED_FOR_SUPER_ADMIN=false

# 64 hex chars (32 bytes) — encrypts rows in platform_integration_secrets. Required for API vault UI.
# SECRETS_MASTER_KEY=

# Optional read replica for GET /api/system/pulse-readonly (falls back to primary).
# DATABASE_READ_REPLICA_URL=postgresql://arena_app:...@replica/arena_dev

# Stripe Connect balance aggregation (Central Station → Financial).
# STRIPE_SECRET_KEY=
# Webhook signing secret (Dashboard → Webhooks → Add endpoint). Required for POST /api/payments/webhook.
# Endpoint URL (prod): https://<API_HOST>/api/payments/webhook  — raw JSON body.
# Subscribe to: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted, invoice.paid
# STRIPE_WEBHOOK_SECRET=whsec_...

# Paystack — Dashboard → Settings → API & Webhooks → Webhook URL: https://<API_HOST>/api/paystack/webhook (charge.success)
# PAYSTACK_SECRET_KEY=sk_test_...

# Flutterwave — Dashboard → Webhooks: https://<API_HOST>/api/flutterwave/webhook (charge.completed). verif-hash = FLUTTERWAVE_SECRET_HASH
# FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-...
# FLUTTERWAVE_SECRET_HASH=...

# Firebase Admin — JSON service account (single line or standard JSON in env). Enables FCM sends + topic subscribe from POST /api/notifications/fcm/register.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Email — optional env fallback when Central Station email_settings.provider is "none".
# Prefer vault keys resend_api_key / smtp_password + platform_config email_settings (see GET /api/system/email-status).
# RESEND_API_KEY=re_...
# MAIL_FROM=noreply@yourdomain.com
# MAIL_FROM_NAME=Arena

# Redis (optional) — distributed lock for forfeit worker + BullMQ prize; host port often 6381
# Optional: tournament discovery catalog second-layer cache (see tournamentCatalogRoutes.js). In-memory TTL always applies.
# REDIS_URL=redis://127.0.0.1:6381
# TOURNAMENT_CATALOG_CACHE_TTL_MS=15000
# FORFEIT_WORKER_POLL_MS=15000
# FORFEIT_LOCK_TTL_SEC=90
# FORFEIT_WORKER=1          # start forfeit poller inside API (default on in code when unset)
# PRIZE_PAYOUT_WORKER=1     # BullMQ prize worker in API process when REDIS_URL set; 0 for dedicated compose worker
# FCM_AUTO_DRAIN=1          # auto-process in-process FCM queue

# Game OAuth (Discord / Steam / Riot) — leave unset for 501 until secrets are present
# OAUTH_ENABLED=true
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=http://localhost:3001/api/oauth/discord/callback
# STEAM_API_KEY=
# RIOT_CLIENT_ID=
# RIOT_CLIENT_SECRET=
# APP_PUBLIC_URL=http://localhost:3001

# When true, CRUD/engine/payments require user_tenants row for X-Tenant-ID (after users have ≥1 membership).
# ENFORCE_USER_TENANTS=false

# Max requests per IP per window for /api/auth (default 120).
# AUTH_RATE_LIMIT_MAX=120

# Max requests per IP per minute for /api/public (default 120).
# PUBLIC_RATE_LIMIT_MAX=120

# POST/PUT/PATCH/DELETE under /api (except routes registered before this middleware, e.g. raw webhooks).
# API_WRITE_RATE_LIMIT_MAX=400

# §4.4 optional refresh session: httpOnly cookie arena_refresh + hashed rows in user_refresh_tokens.
# REFRESH_COOKIE_ENABLED=false

# Optional seeds (startup). Or run once: npm run seed (applies full pack regardless of these flags)
# SEED_OPTIONAL=true   → dev admin + platform_config + game_templates + dev_todos + dev tenant + organizer
# SEED_DEV_USER=true   → dev admin + platform_config + dev tenant + organizer@arena.local / organizer123
# SEED_DEV_TENANT=true → dev tenant + organizer only (no platform admin; see server/src/seed.js header)
# SEED_REFERENCE_DATA=true → game_templates + dev_todos only
# DEV_ADMIN_EMAIL=admin@arena.local
# DEV_ADMIN_PASSWORD=admin123
# DEV_ORGANIZER_EMAIL=organizer@arena.local
# DEV_ORGANIZER_PASSWORD=organizer123
