<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext allowed for local API (127.0.0.1 / 10.0.2.2 / LAN). Production HTTPS still preferred. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
