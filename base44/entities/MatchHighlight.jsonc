{
  "name": "MatchHighlight",
  "type": "object",
  "properties": {
    "tournament_id": {
      "type": "string"
    },
    "match_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "kill",
        "objective",
        "match_end",
        "manual_clip"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "player_email": {
      "type": "string"
    },
    "player_name": {
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "team_name": {
      "type": "string"
    },
    "clip_url": {
      "type": "string"
    },
    "timestamp": {
      "type": "number",
      "description": "Unix timestamp of event"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false
    },
    "pinned_by": {
      "type": "string",
      "description": "Organizer email"
    },
    "likes": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "tournament_id",
    "match_id",
    "type",
    "title"
  ]
}