{
  "name": "PlayerStat",
  "type": "object",
  "properties": {
    "player_email": {
      "type": "string"
    },
    "player_name": {
      "type": "string"
    },
    "match_id": {
      "type": "string"
    },
    "tournament_id": {
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "kills": {
      "type": "number",
      "default": 0
    },
    "deaths": {
      "type": "number",
      "default": 0
    },
    "assists": {
      "type": "number",
      "default": 0
    },
    "won": {
      "type": "boolean",
      "default": false
    },
    "game_title": {
      "type": "string"
    }
  },
  "required": [
    "player_email",
    "match_id"
  ]
}