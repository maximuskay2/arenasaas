{
  "name": "PrizePayment",
  "type": "object",
  "properties": {
    "tournament_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "team_name": {
      "type": "string"
    },
    "captain_email": {
      "type": "string"
    },
    "placement": {
      "type": "number",
      "description": "1 = 1st, 2 = 2nd, 3 = 3rd"
    },
    "prize_amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "paypal",
        "stripe",
        "bank_transfer",
        "manual"
      ],
      "default": "manual"
    },
    "payment_reference": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "confirmed",
        "failed"
      ],
      "default": "pending"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tournament_id",
    "team_id",
    "placement",
    "prize_amount"
  ]
}