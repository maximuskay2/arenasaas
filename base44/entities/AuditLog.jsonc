{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant this log entry belongs to"
    },
    "action": {
      "type": "string",
      "description": "Action performed (e.g. score_override, match_forfeit, team_disqualified)"
    },
    "entity_type": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "actor_email": {
      "type": "string"
    },
    "actor_role": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "previous_value": {
      "type": "string"
    },
    "new_value": {
      "type": "string"
    },
    "tournament_id": {
      "type": "string"
    },
    "ip_address": {
      "type": "string"
    }
  },
  "required": [
    "action",
    "entity_type",
    "actor_email"
  ]
}